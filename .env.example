# Application
APP_NAME=Bifrost
APP_ENV=development
APP_PORT=8000

# Postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=bifrost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bifrost

# Authentication
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_PORT=6379
CACHE_TTL=300
REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# Dozzle (dev log UI only). Set COMPOSE_PROFILES=dev to start it.
# Leave COMPOSE_PROFILES empty in production so Dozzle does not run.
DOZZLE_PORT=8080
COMPOSE_PROFILES=dev
